# Copy this file to .env and fill in real values. Never commit .env.

PORT=8080

# Local Docker DB (see docker-compose.yml in the repo root):
DATABASE_URL=postgres://meditrack:meditrack@localhost:5433/meditrack?sslmode=disable
# Neon (copy from the Neon dashboard -> Connection string):
# DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/meditrack?sslmode=require

# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
TOKEN_TTL=12h

# Comma-separated list of frontend URLs allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Run migrations automatically when the API starts.
AUTO_MIGRATE=true

# First admin, created only if no active admin exists yet.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSWORD=ChangeMe123
